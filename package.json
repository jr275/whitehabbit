    "framer-motion": "^13.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.3.0",
    "next-auth": "5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "^19",
    "react-dom": "^19",
    "recharts": "3.8.0",
