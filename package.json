  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "migrate": "node scripts/migrate.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 --experimental-strip-types --conditions=react-server --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/helpers/register-alias.mjs \"tests/**/*.test.ts\"",
    "boundaries": "node scripts/check-boundaries.mjs",
    "verify": "npm run typecheck && npm run boundaries && npm test",
