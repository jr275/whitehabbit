# Copy this file to .env.local and fill in what you have.
#
# DATABASE_URL and AUTH_SECRET are REQUIRED — the app fails clearly on
# startup/first request without them (see lib/db/client.ts,
# DatabaseNotConfiguredError). Everything else degrades gracefully:
# every tool that needs a credential reports itself as NOT CONNECTED
# (with the real reason) until it's set, rather than faking a result.

# --- Database (required) ---------------------------------------------
# A real PostgreSQL connection string. Locally: any Postgres (see
# migrations/ + `pnpm migrate`). In production: a Neon database
# (Vercel's native Postgres integration) or any other Postgres
# provider's connection string. Never exposed to the browser — read
# only in lib/db/client.ts (server-only).
DATABASE_URL=

# --- Auth (required) --------------------------------------------------
# Auth.js's session-signing secret. Generate one with:
#   openssl rand -base64 32
# Never reuse this between environments; never commit it.
AUTH_SECRET=

# --- Google OAuth (optional) -----------------------------------------
# Enables "Continue with Google" on the login and signup screens. The
# button ONLY appears when BOTH of these are set (see isGoogleConfigured
# in lib/auth.ts) — if either is missing, Google sign-in is silently
# not registered and the UI shows email + password only. No fake OAuth.
# Create credentials at https://console.cloud.google.com/apis/credentials
# and add this authorized redirect URI:
#   <your-origin>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Password reset delivery (optional) ------------------------------
# Password reset generates a real single-use, 1-hour token and stores
# only its SHA-256 hash (see app/api/auth/forgot-password). There is no
# email provider wired up, so outside production the reset link is
# returned to the browser and shown directly (clearly labeled) rather
# than pretending an email was sent. To deliver real emails, add an
# email provider (e.g. Resend) and send the link from that route.

# --- Runtime mode -------------------------------------------------------
# Set to true ONLY in local/preview development to route every LLM call
# through the deterministic local fixture instead of a real provider —
# see lib/agent/tools/llm-providers/development.ts. Hard-blocked when
# VERCEL_ENV=production regardless of this value (lib/runtime-mode.ts)
# — a real deployment can never accidentally serve simulated results.
LLM_DEV_MODE=

# Which LLM provider the worker's LLM tool actually calls. Defaults to
# anthropic. An unrecognized value is treated as NOT CONFIGURED (with
# the exact bad value named) — it never silently falls back to a
# different provider's credentials.
LLM_PROVIDER=anthropic

# --- Anthropic (Messages API) ---------------------------------------
# Required when LLM_PROVIDER=anthropic. Without it, the LLM tool — and
# every skill that depends on it, including Trend Research — blocks
# with "Configure ANTHROPIC_API_KEY to run this worker."
#
# Also used by Knowledge's AI Summary (lib/knowledge/ai-summary.ts) —
# a separate, independent code path (Knowledge cannot import lib/agent,
# see scripts/check-boundaries.mjs) that happens to share this same
# deployment-wide credential. Without it, Summarize returns a clear
# "not configured" state rather than failing silently.
ANTHROPIC_API_KEY=

# Optional: override the model used for real analysis (defaults to
# claude-sonnet-5, confirmed current for this deployment).
LLM_MODEL=

# Optional: override the Anthropic API base URL (defaults to
# https://api.anthropic.com). Deliberately a different variable name
# than ANTHROPIC_BASE_URL, which some environments reserve for their
# own tooling.
ANTHROPIC_BASE_URL_PUBLIC=

# --- Gemini (Generative Language API) --------------------------------
# Required when LLM_PROVIDER=gemini. Without it, the LLM tool blocks
# with "Configure GEMINI_API_KEY to run this worker."
GEMINI_API_KEY=

# Required when LLM_PROVIDER=gemini — there is no built-in default
# model for Gemini (no model id here is confirmed current), so a
# missing GEMINI_MODEL is treated exactly like a missing credential.
# Set it to a currently supported gemini-* model id, e.g. one listed at
# https://ai.google.dev/gemini-api/docs/models at the time you deploy.
GEMINI_MODEL=

# Optional: override the Gemini API base URL (defaults to
# https://generativelanguage.googleapis.com).
GEMINI_BASE_URL_PUBLIC=

# --- Cost ---------------------------------------------------------------
# Optional: override the assumed $/1M-token pricing used to compute
# real AI cost from real token usage. Token counts always come from the
# active provider's own usage field — these only change the $/token
# assumption, never what's real. LLM_INPUT/OUTPUT_COST_PER_MTOK apply to
# Anthropic (kept as the original, provider-agnostic names for
# backward compatibility) and default to Sonnet-class list pricing.
# Gemini has no built-in default rate — set GEMINI_INPUT_COST_PER_MTOK /
# GEMINI_OUTPUT_COST_PER_MTOK explicitly, or its real cost is reported
# as unavailable rather than guessed.
LLM_INPUT_COST_PER_MTOK=
LLM_OUTPUT_COST_PER_MTOK=
GEMINI_INPUT_COST_PER_MTOK=
GEMINI_OUTPUT_COST_PER_MTOK=

# --- Search / Tools -------------------------------------------------------
# The Web Search tool uses the public npm registry (no key required —
# see lib/agent/tools/web-search.ts). A future real search provider
# (Tavily/Bing/etc.) would add its own *_API_KEY here, read server-side
# only, following the exact pattern ANTHROPIC_API_KEY/GEMINI_API_KEY
# already establish.

# --- Trusted proxy hops ---------------------------------------------
# How many proxies sit in front of this application and are trusted to
# have appended to X-Forwarded-For.
#
# This decides the SUBJECT of every pre-session rate limit (password
# reset, password forgot, /api/knowledge/preview). The client IP is
# taken that many entries from the RIGHT of the header, because
# anything a client forges arrives at the LEFT.
#
#   unset / 1   one trusted proxy — correct on Vercel, and for the
#               ordinary single reverse proxy. This is the default.
#   2+          an extra CDN or load balancer in front of that one.
#   0           nothing in front is trusted, so X-Forwarded-For is
#               ignored entirely and every caller shares one bucket.
#               This is the honest setting for a deployment reached
#               directly (a bare `next start` with no proxy): it
#               degrades the limit instead of leaving a forgeable one.
#
# Getting this too HIGH is the dangerous direction — it walks left into
# entries a client controls. Too low only costs precision.
TRUSTED_PROXY_HOPS=
